<!--this file defines the side navigation bar that is present on all pages of the application
    including what different buttons do and the design of the navigation bar as well.
-->
@inject AppState AppState

<div style="background-color:#312F2F;" class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a style="color: #F6E8EA;" class="navbar-brand" href="">Blaze</a>
    </div>
</div>

<input style="background-color:#312F2F;" type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div style="background-color:#312F2F;" class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="map" style="color: #F6E8EA !important; height: 10vh;">
                <span  class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Map
            </NavLink>
        </div>
        @if (AppState.Hosting) {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="statistics" style="color: #F6E8EA !important; height: 10vh;">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Statistics
                </NavLink>
            </div>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="userinput" style="color: #F6E8EA !important; height: 10vh;">
                <img style="margin-right: 10px;" src="images/input-field.png" aria-hidden="true" /> User Input
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings" style="color: #F6E8EA !important; height: 10vh;">
                <img style="margin-right: 10px;" src="images/SettingsIcon.png" aria-hidden="true" />  Settings
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private string Profile => AppState.Hosting ? "Hosting" : "Not Hosting";

    protected override void OnInitialized() {
        AppState.PropertyChanged += (sender, args) => {
            if (args.PropertyName == nameof(AppState.Hosting)) {
                InvokeAsync(StateHasChanged);
            }
        };
    }
}
