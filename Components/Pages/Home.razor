@inject IJSRuntime JSRuntime
@page "/"

<h1>Hello, world!</h1>

Welcome to your new app.
<div id="map" style="height: 80vh;"></div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initMap");
        }
    }
}
