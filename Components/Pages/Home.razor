@page "/"
@using GoogleMapsComponents
@using GoogleMapsComponents.Maps
@inject NavigationManager Navigation
@inject AppState AppState

<link href="css/Home.css" rel="stylesheet" />

<div class="page" style="background-color: #F6E8EA;">
    <h1 style="text-decoration: underline; padding: 10px; color: #EF626C;">Welcome to Blaze</h1>
    <h2 style="padding: 10px; color: #22181C;">Please choose a profile</h2>
    <div class="button-container">
        <button class="profile-button admin-button" @onclick="AdminClick">
            <img src="images/admin_icon.svg" alt="Admin" class="button-image" />
            <span>Admin</span>
        </button>
        <button class="profile-button user-button" @onclick="UserClick">
            <img src="images/user_icon.svg" alt="User" class="button-image" />
            <span>User</span>
        </button>
    </div>
</div>

@code {
    private void AdminClick() {
        SessionData.signedIn = true;
        SessionData.hosting = true;
        AppState.Hosting = true;
        InvokeAsync(StateHasChanged);
        Navigation.NavigateTo("/Map");
    }

    private void UserClick() {
        SessionData.signedIn = true;
        SessionData.hosting = false;
        AppState.Hosting = false;
        InvokeAsync(StateHasChanged);
        Navigation.NavigateTo("/Map");
    }
}
