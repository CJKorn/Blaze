@page "/map"
<!--defines the elements and styles for the Map page-->
@using GoogleMapsComponents
@using GoogleMapsComponents.Maps

@inject NavigationManager NavigationManager
<div class="page" style="background-color: #F6E8EA;">
    <h1 style="text-align: center; color: #22181C; text-decoration: underline;">Incident Map</h1>

    @if (SessionData.Key != null) {
        <div style="height:@Height">
            <GoogleMap @ref="@_map1" Id="map1" Options="@mapOptions" Height="100%" OnAfterInit="AfterMapRender"></GoogleMap>
        </div>
    } else {
        <div style="height:@Height">
            <h1>NO API KEY!!!</h1>
        </div>
    }
    <!--determines if a marker exists and only shows the button if there is a valid marker-->
    @if (Marker != null) {
        <button type="button" class="btn btn-primary" @onclick="OpenReport" style="padding: 5px; margin: 5px float: right;">Report Incident</button>
    }

    @if (SessionData.SelectedReport != null) {
        <div class="sidebar" style="position: absolute; right: 0; top: 0; width: 300px; height: 100%; background-color: #FFFFFF; border-left: 1px solid #CCCCCC; padding: 10px; padding: 30px;">
            <br />
            <h2>@SessionData.SelectedReport.Name</h2>
            <p><strong>Title:</strong> @SessionData.SelectedReport.Name</p>
            <p><strong>Description:</strong> @SessionData.SelectedReport.Description</p>
            <p><strong>Category:</strong> @SessionData.SelectedReport.Cat</p>
            <!-- <p><strong>Icon:</strong> <img src="@SessionData.SelectedReport.Icon" alt="Icon" /></p> -->
            @if (SessionData.SelectedReport is MonoReport) {
				<p><strong>Latitude:</strong> @((SessionData.SelectedReport as MonoReport).Lat)</p>
				<p><strong>Longitude:</strong> @((SessionData.SelectedReport as MonoReport).Lng)</p>
			}
            @if (SessionData.hosting) {
                <!--<button type="button" class="btn btn-primary" @onclick="Edit" style="padding: 5px; margin: 5px;">Edit</button>-->
				<button type="button" class="btn btn-primary" @onclick="DeleteReport" style="padding: 5px; margin: 5px;">Delete</button>
            }
        </div>
    }
</div>

@code {
 
    private GoogleMap? _map1;
    private MapOptions? mapOptions;
    private string Height = "500px";
    private LatLngBounds? _bounds;
    private Marker? Marker;
    //this method runs when the page is first initialised, and defines a new MapOptions object, that holds the "current settings" of the map, and also gets the reports
    protected override void OnInitialized() {
        mapOptions = new MapOptions() {
                Zoom = SessionData.Zoom,
                Center = new LatLngLiteral() {
                    Lat = SessionData.Lat,
                    Lng = SessionData.Lng
                },
                MapTypeId = MapTypeId.Roadmap
            };
        SessionData.Reports = ReportTools.GetReports();
    }
    //runs after the map has been rendered and creates listeners, that determine when things change.
    private async Task AfterMapRender() {
        _bounds = await LatLngBounds.CreateAsync(_map1.JsRuntime);
        await _map1.InteropObject.AddListener("drag", RecordState);
        await _map1.InteropObject.AddListener("zoom_changed", RecordState);
        await _map1.InteropObject.AddListener("center_changed", RecordState);
        await _map1.InteropObject.AddListener<MouseEvent>("click", async (e) => await OnClick(e));
        await _map1.InteropObject.AddListener<MouseEvent>("rightclick", async (e) => await OnRightClick(e));

        await PlacePinsFromJson();
    }
    //method below is used to record the current state of the map, particularly its position, and zoom
    private async void RecordState() {
        LatLngLiteral Position = await _map1.InteropObject.GetCenter();
        SessionData.Lat = Position.Lat;
        SessionData.Lng = Position.Lng;
        SessionData.Zoom = (int)Math.Round(await _map1.InteropObject.GetZoom());
    }
    //the below method runs when the map is click, and makes the selected report null
    private async Task OnClick(MouseEvent e) {
        SessionData.SelectedReport = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnRightClick(MouseEvent e) {
        LatLngLiteral Position = e.LatLng;
        SessionData.ClickedLat = Position.Lat;
        SessionData.ClickedLng = Position.Lng;
        await InvokeAsync(StateHasChanged);
        await AddMarker(Position);
    }
    //the method below creates and adds a new marker on the map if there isn't one in the current position alredy
    private async Task AddMarker(LatLngLiteral position) {
        if (Marker != null) {
            await Marker.SetMap(null);
            Marker = null;
        }

        MarkerOptions options = new MarkerOptions() {
                Position = position,
                Map = _map1.InteropObject,
                Label = "Temp",
                Draggable = true,
                Icon = new Icon() {
                    Url = "https://developers.google.com/maps/documentation/javascript/examples/full/images/beachflag.png"
                }
            };
        Marker = await Marker.CreateAsync(_map1.JsRuntime, options);
        await InvokeAsync(StateHasChanged);
    }

    private void OpenReport() {
        SessionData.Clicked = true;
        NavigationManager.NavigateTo("/userinput");
    }
    //the method below calls two other methods that are located within this class, to place both mono and poly pins from the .JSON
    private async Task PlacePinsFromJson() {
        await PlaceMonoPinsFromJson();
        await PlacePolyPinsFromJson();
    }
    //the below method is used to show points on a map by reading and writing from a .JSON file, with mono pins
    private async Task PlaceMonoPinsFromJson() {
        List<MonoReport> monos = new List<MonoReport>();
        monos = ReportTools.GetMonos(SessionData.Reports);
        //Do this Toby pls
        //Use dictionary/switch statement to set url to fitting icons
        string url = "images/fire.png";
        foreach (MonoReport mono in monos) {
            MarkerOptions options = new MarkerOptions {
                    Title = mono.Name,
                    Position = new LatLngLiteral {
                        Lat = mono.Lat,
                        Lng = mono.Lng
                    },
                    Map = _map1.InteropObject,
                    // Label = "Incident",

                    Icon = new Icon() {
                        Url = url
                    }
                };
            Marker marker = await Marker.CreateAsync(_map1.JsRuntime, options);
            await marker.AddListener<MouseEvent>("click", async e => await MarkerClicked(e, marker, mono));
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PlacePolyPinsFromJson()
    {
        // Define color mappings for each category
        var categoryColors = new Dictionary<Report.Category, (string StrokeColor, string FillColor)>
    {
        { Report.Category.Accident, ("#FF0000", "#FFCCCC") },
        { Report.Category.Fire, ("#FF4500", "#FFA07A") },
        { Report.Category.Crime, ("#8B0000", "#DC143C") },
        { Report.Category.PowerOutage, ("#FFD700", "#FFF8DC") },
        { Report.Category.WaterOutage, ("#1E90FF", "#ADD8E6") },
        { Report.Category.Pollution, ("#556B2F", "#8FBC8F") },
        { Report.Category.WildlifeIncident, ("#228B22", "#98FB98") },
        { Report.Category.Traffic, ("#FFA500", "#FFE4B5") },
        { Report.Category.RoadClosure, ("#A52A2A", "#FA8072") },
        { Report.Category.PublicTransit, ("#0000FF", "#87CEFA") },
        { Report.Category.Flood, ("#4169E1", "#B0C4DE") },
        { Report.Category.SevereWeather, ("#2F4F4F", "#B0E0E6") },
        { Report.Category.Heatwave, ("#FF6347", "#FFE4E1") },
        { Report.Category.PublicGathering, ("#9932CC", "#DDA0DD") },
        { Report.Category.Construction, ("#B8860B", "#FFD700") },
        { Report.Category.Default, ("#000000", "#FFFFFF") } // Default colors if category is not found
    };

        
        List<PolyReport> polys = ReportTools.GetPolys(SessionData.Reports);

        foreach (PolyReport poly in polys)
        {
            // Get colors based on the category of the polygon
            var (strokeColor, fillColor) = categoryColors.ContainsKey(poly.Cat)
                ? categoryColors[poly.Cat]
                : categoryColors[Report.Category.Default];

            IEnumerable<IEnumerable<LatLngLiteral>> points = new List<IEnumerable<LatLngLiteral>>
        {
            poly.LatLngLiterals
        };

           
            PolygonOptions options = new PolygonOptions
                {
                    Paths = points,
                    StrokeColor = strokeColor,
                    StrokeOpacity = 0.8f,
                    StrokeWeight = 2,
                    FillColor = fillColor,
                    FillOpacity = 0.35f,
                    Map = _map1.InteropObject
                };

           
            Polygon polygon = await Polygon.CreateAsync(_map1.JsRuntime, options);

           
            await polygon.AddListener<MouseEvent>("click", async e => await MarkerClicked(e, polygon, poly));

           
            await InvokeAsync(StateHasChanged);
        }
    }
    //this method runs when the marker is clicked, and updates SessionData;
    private async Task MarkerClicked<T>(MouseEvent e, T marker, Report report) {
        SessionData.SelectedReport = report;
        await InvokeAsync(StateHasChanged);
        // SessionData.SelectedMarker = marker;
        // NavigationManager.NavigateTo("/userinput");
    }
    //the method below is used to delete a pre-existing report and removes it from SessionData, and returns to the Map page.
    private void DeleteReport() {
		ReportTools.DeleteReport(SessionData.SelectedReport);
		SessionData.SelectedReport = null;
		NavigationManager.NavigateTo("/map");
        InvokeAsync(StateHasChanged);
	}
}
