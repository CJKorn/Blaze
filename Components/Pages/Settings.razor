@page "/settings"
<h3>Settings</h3>
<!--html goes here
    the other code goes within the code braces
-->
<p>IP Address</p>
<input type="text" @bind="IpAddress" style="width=500px"/>
<!--IF STATEMENT IS NEEDED TO CHECK IF LOGGED IN-->
<button @onclick="ConfirmIpAddress">Confirm IP</button>
<br /><br />
<p>API Key</p>
<input type="text" @bind="ApiKey" style="width=500px"/>
<button @onclick="ConfirmApiKey">Confirm</button>
<br /><br />
<button @onclick="ResetApp">Reset Application</button>
@code {
    private string ApiKey;
    private bool showApiKeyInput = false;
    private readonly string apiKeyFilePath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Blaze/keys.apikeys");
    private string IpAddress;
    protected override void OnInitialized()
    {
        if (File.Exists(apiKeyFilePath))
        {
            ApiKey = File.ReadAllText(apiKeyFilePath);
        }
    }

    // Save the updated API key to the file and hide the input field
    private void ConfirmApiKey()
    {
        SessionData.Key = ApiKey;
        File.WriteAllText(apiKeyFilePath, ApiKey);
        showApiKeyInput = false;
    }
    private void ConfirmIpAddress()
    {
        //this still needs to be done, not entirely sure what this is for
    }
    private void ResetApp()
    {
    }
}
