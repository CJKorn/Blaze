@using GoogleMapsComponents
@using GoogleMapsComponents.Maps

@page "/settings"
<div class="page" style="background-color: #F6E8EA;">
    <h3 style="color: #22181C; text-align: center;">Settings</h3>
    <!--html goes here
        the other code goes within the code braces
    -->
    <p>IP Address</p>
    <input type="text" @bind="IpAddress" style="width=500px" disabled="@IsHosting"/>
    <button @onclick="ConfirmIpAddress" disabled="@IsHosting" style="padding: 5px;">Confirm IP</button>
    <br /><br />
    <p>API Key</p>
    <input type="text" @bind="ApiKey" style="width=500px"/>
    <button @onclick="ConfirmApiKey" style="padding: 5px;">Confirm</button>
    <br /><br />
    @if(apiPressed == true)
    {
        <textfield style="font-weight: bold; color: red;">Please restart the application</textfield>
        <br /><br />
    }
   
    <p>Debug Info</p>
    <textarea value="@DebugInfo" style="width:500px; height:200px;"></textarea>

    <!-- Delete before finishing -->
    <br />
    <button @onclick="TempData">Temp Data</button>
</div>
@code {
    private bool apiPressed = false;
    private string ApiKey;
    private bool showApiKeyInput = false;
    private readonly string apiKeyFilePath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Blaze/keys.apikeys");
    private string IpAddress;
    private bool IsHosting => SessionData.hosting;
    private string DebugInfo => SessionData.debug;

    protected override void OnInitialized()
    {
        if (File.Exists(apiKeyFilePath))
        {
            ApiKey = File.ReadAllText(apiKeyFilePath);
        }

        if (IsHosting) {
            IpAddress = SessionData.myIP;
        }
    }

    // Save the updated API key to the file and hide the input field
    private void ConfirmApiKey()
    {
        SessionData.Key = ApiKey;
        File.WriteAllText(apiKeyFilePath, ApiKey);
        showApiKeyInput = false;
        apiPressed = true;
    }
    private void ConfirmIpAddress()
    {
        SessionData.IP = IpAddress;
        InvokeAsync(StateHasChanged);
    }
    private void ResetApp() {
        System.Environment.Exit(0);
    }

    private void TempData() {
        List<Report> reports = new List<Report>();
        reports.Add(new Mono("1", "1", 1, 1, "", Report.Category.Default));
        reports.Add(new Mono("2", "2", 2, 2, "", Report.Category.Default));
        reports.Add(new Mono("3", "3", 3, 3, "", Report.Category.Default));
        reports.Add(new Mono("4", "4", 4, 4, "", Report.Category.Default));
        reports.Add(new Mono("5", "5", 5, 5, "", Report.Category.Default));
        List<LatLngLiteral> points = new List<LatLngLiteral>();
        points.Add(new LatLngLiteral() { Lat = 1, Lng = 1 });
        points.Add(new LatLngLiteral() { Lat = 1, Lng = 2 });
        points.Add(new LatLngLiteral() { Lat = 2, Lng = 1 });
        points.Add(new LatLngLiteral() { Lat = 4, Lng = 4 });
        reports.Add(new Poly("6", "6", points, "", Report.Category.Default));
        // SessionData.Reports = reports;
        // ReportTools.SaveReports();
        // reports = ReportTools.GetReports();
        // SessionData.Reports = reports;
        // ReportTools.SaveReports();

        ReportTools.SendReports(reports);
    }
}
