@using System.ComponentModel.DataAnnotations
@using GoogleMapsComponents
@using GoogleMapsComponents.Maps

@page "/userinput"
<!--defines the elements of the User Input/Report page, including the styles-->
<div class="page" style="background-color: #F6E8EA;">



	<h3 style="color: #22181C; text-align: center;">Incident Report</h3>

	@if (SessionData.Key != null) {
		<div style="height:@Height">
			<GoogleMap @ref="@_map1" Id="map1" Options="@mapOptions" Height="100%" OnAfterInit="AfterMapRender"></GoogleMap>
		</div>
	} else {
		<div style="height:@Height">
			<h1>NO API KEY!!!</h1>
		</div>
	}

	<EditForm Model="@userInput" OnValidSubmit="HandleSubmit">
		<DataAnnotationsValidator />
		<ValidationSummary />

		<div style="padding: 10px;">
			<label for="incident">Incident Title</label>
			<InputText id="incident" @bind-Value="@userInput.Incident" class="form-control" />
		</div>

		<div style="padding: 10px">
			<label for="description">Description of incident</label>
			<InputText id="description" @bind-Value="@userInput.Description" class="form-control" />
		</div>
		<div style="padding: 10px;">
			<label for="type">Incident Type</label>
			<!--defines a drop down selection box-->
			<select name="type">
				<option value="">Select Incident Type</option>
				<option value="1">Natural Disaster</option>
				<option value="2">Transit Incident</option>
				<option value="3">Crime Scene</option>
				<option value="4">Fire</option>
				<option value="5">Infrastructure Outage</option>
				<option value="6">Other</option>
			</select>
		</div>
		<button type="submit" class="btn btn-primary">Submit</button>
	</EditForm>

	@if (isSubmitted) {
		<p>Form submitted successfully! Incident: @userInput.Incident Location: @userInput.Description</p>
	}
</div>


@code {
	//below code defines various data elements to be used byt the page
	// public string Incident { get; set; }
	// public string Description { get; set; }
	UserInputModel userInput = new UserInputModel();
	private bool isSubmitted = false;
	private GoogleMap _map1;
	private MapOptions mapOptions;
	private string Height = "300px";
	private LatLngBounds _bounds;
	private Marker Marker;

	//defines the getters and setters to be default for both the Incident and its Description
	public class UserInputModel
	{
		public string Incident { get; set; }
		public string Description { get; set; }
	}
	//the method below creates a new report object when a user submits a report, and changes the value of a boolean to true.
	private void HandleSubmit()
	{
		Report report = new Mono(
			userInput.Incident,
			userInput.Description,
			SessionData.ClickedLat,
			SessionData.ClickedLng,
			"https://developers.google.com/maps/documentation/javascript/examples/full/images/beachflag.png",
			Report.Category.Default
		);
		// SessionData.Reports.Add(report);
		ReportTools.SendReports(report);

		// Set the flag to show submission message
		isSubmitted = true;
	}
	//the method below runs upon first initialising the interface and it defines a new object of type mapObjects that determines zoom, longitude and latitude.
	protected override void OnInitialized() {
		mapOptions = new MapOptions() {
				Zoom = SessionData.Zoom,
				Center = new LatLngLiteral() {
					Lat = SessionData.Lat,
					Lng = SessionData.Lng
				},
				MapTypeId = MapTypeId.Roadmap
			};
	}
	//this method runs after the map has rendered, and creates various listeners to check for state changes
	private async Task AfterMapRender() {
		_bounds = await LatLngBounds.CreateAsync(_map1.JsRuntime);
		await _map1.InteropObject.AddListener("drag", RecordState);
		await _map1.InteropObject.AddListener("zoom_changed", RecordState);
		await _map1.InteropObject.AddListener("center_changed", RecordState);
		await _map1.InteropObject.AddListener<MouseEvent>("click", async (e) => await OnClick(e));

		if (SessionData.Clicked == true) {
			LatLngLiteral position = ReportTools.LatLng(SessionData.ClickedLat, SessionData.ClickedLng);
			SessionData.Clicked = false;
			await AddMarker(position);
		}
	}
	//this method is used to recird the current state of the map, including the longitutde, latitude and the zoom
	private async void RecordState() {
		LatLngLiteral Position = await _map1.InteropObject.GetCenter();
		SessionData.Lat = Position.Lat;
		SessionData.Lng = Position.Lng;
		SessionData.Zoom = (int)Math.Round(await _map1.InteropObject.GetZoom());
	}
	//the method below runs after a click occurs on teh map, and updates values accordingly, and adds a marker
	private async Task OnClick(MouseEvent e) {
		LatLngLiteral Position = e.LatLng;
		SessionData.ClickedLat = Position.Lat;
		SessionData.ClickedLng = Position.Lng;
		await InvokeAsync(StateHasChanged);
		await AddMarker(Position);
	}
	//the method below adds a marker at the current position (if one doesn't already exist), and deletes an existing marker if one exists at the current location
	private async Task AddMarker(LatLngLiteral position) {
		if (Marker != null) {
			await Marker.SetMap(null);
			Marker = null;
		}

		MarkerOptions options = new MarkerOptions() {
				Position = position,
				Map = _map1.InteropObject,
				Label = "Temp",
				Draggable = true,
				Icon = new Icon() {
					Url = "https://developers.google.com/maps/documentation/javascript/examples/full/images/beachflag.png"
				}
			};
		Marker = await Marker.CreateAsync(_map1.JsRuntime, options);
		await InvokeAsync(StateHasChanged);
	}
}
